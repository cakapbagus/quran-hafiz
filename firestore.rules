rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/backups/current {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['content', 'size', 'updatedAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 900000
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 900000
        && request.resource.data.updatedAt is timestamp;
    }
  }
}
